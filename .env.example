# Environment variables for docker-compose.yml.
#
# Copy this file to .env (which is gitignored) and edit the copy:
#
#     cp .env.example .env
#
# Docker Compose reads .env from this folder automatically. Never commit .env.
#
# ---------------------------------------------------------------------------
# BLOODLINK_JWT_SECRET — the key that signs every login token.
#
# Anyone who knows this value can create a valid login for ANY account,
# administrators included, so on a real deployment it must be long, random and
# private. Generate one with:
#
#     openssl rand -base64 48
#
# and paste the output in place of the value below (no quotes, no spaces).
#
# The value below is the PUBLIC PLACEHOLDER: it is in this repository, so everyone
# can read it. It is left here so a local demo works straight after copying, and
# Business Rule 15 keeps it safe:
#   - under the "demo" profile docker-compose.yml uses, the backend starts but
#     prints a large warning that the secret is insecure;
#   - under any other profile (prod, staging, anything else), the backend refuses
#     to start at all.
# Keep this line identical to the default in application.properties.example —
# JwtSecretPolicyTest fails the build if the two ever differ.
# ---------------------------------------------------------------------------
BLOODLINK_JWT_SECRET=local-dev-only-change-me-0123456789abcdef
