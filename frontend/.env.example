# Every environment variable the frontend reads. Optional: with no file at all,
# the defaults below are used.
#
# To change one for local development, copy this file to .env.local (gitignored)
# and edit the copy:
#     PowerShell:  Copy-Item .env.example .env.local
#     macOS/Linux: cp .env.example .env.local
# Restart `npm run dev` afterwards. Vite reads these at BUILD time and bakes them
# into the JavaScript the browser downloads, so nothing secret may ever go here.

# Optional. Where the backend is, as the browser reaches it. Default:
# http://localhost:8080. The real-time WebSocket uses the same address plus /ws,
# so there is no separate WebSocket variable. A trailing slash is ignored.
# On Cloudflare Pages it is set in the project's settings (DEPLOYMENT.md) and must be https://:
# the build stops otherwise.
VITE_API_BASE_URL=http://localhost:8080
