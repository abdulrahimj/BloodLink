spring.application.name=bloodlink

# --- Server ---
server.port=${SERVER_PORT:8080}

# --- Datasource (PostgreSQL) ---
# Replace DB_USERNAME / DB_PASSWORD below with your real local PostgreSQL credentials
# (this copy is gitignored; the .example template must keep the placeholders).
# Alternatively leave them, and set SPRING_DATASOURCE_USERNAME / SPRING_DATASOURCE_PASSWORD
# (and SPRING_DATASOURCE_URL) in the terminal: environment variables outrank this file.
# Create the database first:  CREATE DATABASE bloodlink_dev;
# bloodlink_dev is for running the app. Tests use bloodlink_test only, never this database.
spring.datasource.url=jdbc:postgresql://localhost:5432/bloodlink_dev
spring.datasource.username=DB_USERNAME
spring.datasource.password=DB_PASSWORD
spring.datasource.driver-class-name=org.postgresql.Driver

# --- Flyway (owns the schema) ---
spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration

# --- JPA / Hibernate ---
# Flyway owns the schema; Hibernate only validates that the entities match the migrated tables.
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.open-in-view=false
spring.jpa.properties.hibernate.jdbc.time_zone=UTC

# --- Authentication (stateless JWT) ---
# The signing secret. HMAC-SHA256 needs at least 256 bits, so this must be 32+
# bytes or the application refuses to start, under every profile (JwtSecretPolicy).
# The README's "Setting a real JWT secret" section shows how to generate and set one.
# The default below is a PUBLIC PLACEHOLDER for local development only — set
# BLOODLINK_JWT_SECRET in the environment for any deployed instance and never commit
# the real value. Business Rule 15: the application refuses to start on this
# placeholder under any profile except the default one and "demo", and prints a
# large warning even then. Do not change the placeholder text without changing
# JwtSecretPolicy.PUBLIC_PLACEHOLDER too (JwtSecretPolicyTest fails if they differ).
bloodlink.jwt.secret=${BLOODLINK_JWT_SECRET:local-dev-only-change-me-0123456789abcdef}
# Token lifetime, in milliseconds. 24 hours: long enough for a full shift at a
# facility without re-authenticating, short enough that a revoked role takes effect
# within a day (tokens are stateless and cannot be individually revoked).
bloodlink.jwt.expiration-ms=${BLOODLINK_JWT_EXPIRATION_MS:86400000}

# --- Browser origins allowed to call the API and open a WebSocket ---
# One list, read by both SecurityConfig (CORS for REST) and WebSocketConfig (the
# STOMP/SockJS handshake). Kept as a property rather than two hard-coded lists so
# the two can never drift apart and leave real-time working where REST does not,
# or the reverse. The defaults are Vite's dev ports; override for a deployment.
bloodlink.cors.allowed-origins=${BLOODLINK_ALLOWED_ORIGINS:http://localhost:5173,http://localhost:5174,http://localhost:5175}

# --- Daily batch expiry notices to blood bank staff (Business Rule 26) ---
# A Spring cron (second minute hour day-of-month month day-of-week), read in UTC:
# 06:00 every day by default. If the server starts after that time, it also runs
# once at startup; a second run on the same day sends nothing. false turns the job
# off entirely (the integration tests do this).
bloodlink.expiry-notifications.enabled=${BLOODLINK_EXPIRY_NOTIFICATIONS_ENABLED:true}
bloodlink.expiry-notifications.cron=${BLOODLINK_EXPIRY_NOTIFICATIONS_CRON:0 0 6 * * *}

# --- The first administrator (Business Rule 27) ---
# When the server starts and NO active administrator exists, it creates one from these
# four settings, which must all be set. Set them as ENVIRONMENT VARIABLES, never here:
# this file is a template, and a real password must never be written into it.
#   BLOODLINK_BOOTSTRAP_ADMIN_PHONE     e.g. 076000000 or +232 76 000 000
#   BLOODLINK_BOOTSTRAP_ADMIN_NAME      the administrator's full name
#   BLOODLINK_BOOTSTRAP_ADMIN_EMAIL     required, like every staff account
#   BLOODLINK_BOOTSTRAP_ADMIN_PASSWORD  meets the password rule (README), temporary: it must be
#                                       changed at the first sign-in
# If any active administrator exists they are ignored, and no existing account is ever
# changed. Never logged. Remove them once the administrator has signed in.
bloodlink.bootstrap-admin.phone=${BLOODLINK_BOOTSTRAP_ADMIN_PHONE:}
bloodlink.bootstrap-admin.name=${BLOODLINK_BOOTSTRAP_ADMIN_NAME:}
bloodlink.bootstrap-admin.email=${BLOODLINK_BOOTSTRAP_ADMIN_EMAIL:}
bloodlink.bootstrap-admin.password=${BLOODLINK_BOOTSTRAP_ADMIN_PASSWORD:}

# --- "Forgot password?" (Business Rule 33) ---
# Optional. A phone number the Sign in page shows under the "Forgot password?" answer
# ("Or call BloodLink on ..."), shown as entered. Empty (the default) shows nothing.
bloodlink.support-phone=${BLOODLINK_SUPPORT_PHONE:}
# The request form always answers after at least this many milliseconds, so a registered
# number cannot be told from an unknown one by how fast the answer comes. Default 500.
bloodlink.password-reset-requests.min-response-ms=${BLOODLINK_PASSWORD_RESET_MIN_RESPONSE_MS:500}

# --- Rate limits (Business Rule 34) ---
# Counted in server memory, so a restart forgets them. Sign-in, per phone number: this many
# FAILED attempts within the window lock the number for lock-minutes, even with the right password.
bloodlink.rate-limit.sign-in.phone.max-failures=${BLOODLINK_RATE_LIMIT_PHONE_MAX_FAILURES:3}
bloodlink.rate-limit.sign-in.phone.window-minutes=${BLOODLINK_RATE_LIMIT_PHONE_WINDOW_MINUTES:15}
bloodlink.rate-limit.sign-in.phone.lock-minutes=${BLOODLINK_RATE_LIMIT_PHONE_LOCK_MINUTES:15}
# Sign-in, per internet address: failed attempts by anyone sharing that address.
bloodlink.rate-limit.sign-in.address.max-failures=${BLOODLINK_RATE_LIMIT_ADDRESS_MAX_FAILURES:30}
bloodlink.rate-limit.sign-in.address.window-minutes=${BLOODLINK_RATE_LIMIT_ADDRESS_WINDOW_MINUTES:15}
bloodlink.rate-limit.sign-in.address.wait-minutes=${BLOODLINK_RATE_LIMIT_ADDRESS_WAIT_MINUTES:15}
# "Forgot password?" requests per internet address, within the window.
bloodlink.rate-limit.password-reset.max-requests=${BLOODLINK_RATE_LIMIT_PASSWORD_RESET_MAX_REQUESTS:10}
bloodlink.rate-limit.password-reset.window-minutes=${BLOODLINK_RATE_LIMIT_PASSWORD_RESET_WINDOW_MINUTES:60}
# New accounts per internet address, within the window. Only accounts actually created count.
bloodlink.rate-limit.registration.max-accounts=${BLOODLINK_RATE_LIMIT_REGISTRATION_MAX_ACCOUNTS:10}
bloodlink.rate-limit.registration.window-minutes=${BLOODLINK_RATE_LIMIT_REGISTRATION_WINDOW_MINUTES:60}
# The most numbers or addresses each limit remembers at once, so a flood cannot exhaust memory.
bloodlink.rate-limit.max-entries=${BLOODLINK_RATE_LIMIT_MAX_ENTRIES:10000}
# Leave false unless a proxy you control sits in front: a visitor can fake X-Forwarded-For.
# When true, the address comes from that header, counting this many entries from the right.
bloodlink.rate-limit.trust-proxy-headers=${BLOODLINK_TRUST_PROXY_HEADERS:false}
bloodlink.rate-limit.trusted-proxy-hops=${BLOODLINK_TRUSTED_PROXY_HOPS:1}
