# Every environment variable the backend reads, for running it WITHOUT Docker
# (`.\mvnw.cmd spring-boot:run` or `java -jar`). An uncommented line shows the
# default used when that variable is not set; a commented-out line (# NAME=...) is
# unset by default and shows an example or an obvious placeholder.
#
# Spring Boot does NOT read a .env file. Set these as environment variables in the
# terminal you start the backend from. The README shows how, in PowerShell:
#     $env:BLOODLINK_JWT_SECRET = "..."      (this terminal only)
# Never commit real values. If you copy this file to backend/.env, that copy is
# gitignored, but the backend still will not read it.
#
# Database credentials normally go in src/main/resources/application.properties
# (copied from application.properties.example, gitignored), not in variables.
#
# !! TESTS USE bloodlink_test ONLY. Never point tests at bloodlink_dev, which holds
# !! real data. The integration tests take their database from
# !! src/test/resources/application-test.properties, but a SPRING_DATASOURCE_*
# !! variable left set in your terminal would override it; IntegrationDatabaseGuard
# !! then refuses to run them. Set those variables per terminal, not permanently.

# --- Security ---------------------------------------------------------------

# REQUIRED for any real deployment: the login-token signing key, at least 32 bytes
# (48 random bytes in Base64 recommended; see README "Setting a real JWT secret").
# Optional on your own machine: when unset, the public placeholder is used, with a
# warning, under the default and "demo" profiles only. Empty or too short: refused.
# Changing it signs every user out.
# BLOODLINK_JWT_SECRET=paste-your-own-generated-value-here

# Optional. How long a login token lasts, in milliseconds. Default: 24 hours.
BLOODLINK_JWT_EXPIRATION_MS=86400000

# Optional. Comma-separated browser origins allowed to call the API and open the
# WebSocket. Default: Vite's local dev ports. Set to the frontend's real address
# when deploying.
BLOODLINK_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# --- The first administrator (Business Rule 27) ------------------------------

# Optional. Used only when the backend starts and NO active administrator exists:
# it then creates one from these four, which must all be set (README, "Creating the
# first administrator"). Ignored whenever an active administrator exists; no existing
# account is ever changed. The password is temporary, follows the password rule (README) and must be
# changed at the first sign-in; it is never logged. Placeholders only: never write
# real values here. Remove them from your terminal once the administrator has signed in.
# BLOODLINK_BOOTSTRAP_ADMIN_PHONE=076000000
# BLOODLINK_BOOTSTRAP_ADMIN_NAME=Your Name
# BLOODLINK_BOOTSTRAP_ADMIN_EMAIL=you@example.org
# BLOODLINK_BOOTSTRAP_ADMIN_PASSWORD=Choose-a-temporary-password-1

# --- Daily batch expiry notices (Business Rule 26) ---------------------------

# Optional. false turns off the daily job that tells blood bank staff about batches
# 7 days from expiry and expired batches still holding units. Default: on.
BLOODLINK_EXPIRY_NOTIFICATIONS_ENABLED=true

# Optional. When the job runs: a Spring cron (second minute hour day month weekday),
# read in UTC. Default: 06:00 every day.
BLOODLINK_EXPIRY_NOTIFICATIONS_CRON=0 0 6 * * *

# --- Server -----------------------------------------------------------------

# Optional. The port the backend listens on. Default: 8080.
SERVER_PORT=8080

# Hosted only: under the "prod" profile the backend listens on PORT, which Render sets (10000).
# Leave it unset locally. See DEPLOYMENT.md.
# PORT=10000

# --- The hosted demo only (profiles demo,prod; DEPLOYMENT.md, "Demo passwords") --------

# Required when the demo runs with any non-local profile, which otherwise refuses to start. They replace
# the published demo password: the first for every demo account except the administrator, the second for
# the demo administrator. Each follows the password rule (README), and they differ. Leave both unset locally:
# the plain "demo" profile then keeps BloodLink@2026. Placeholders only: never write real values here.
# BLOODLINK_DEMO_PASSWORD=Choose-a-shared-demo-password-1
# BLOODLINK_DEMO_ADMIN_PASSWORD=Choose-a-different-admin-password-2

# Optional. Unset means the default profile (your local bloodlink_dev). "demo" loads
# the fictional demo data into bloodlink_demo, never bloodlink_dev. Any other
# profile requires a real BLOODLINK_JWT_SECRET.
# SPRING_PROFILES_ACTIVE=demo

# --- Database (optional overrides) -------------------------------------------
# Standard Spring Boot variables. When set, they replace the datasource values in
# application.properties (or application-demo.properties). Unset, those files decide:
# the default profile uses bloodlink_dev as configured in your application.properties;
# the demo profile uses jdbc:postgresql://localhost:5432/bloodlink_demo as postgres.

# Optional. The JDBC address of the database.
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/bloodlink_dev

# Optional. Your PostgreSQL user name.
# SPRING_DATASOURCE_USERNAME=postgres

# Optional. Your PostgreSQL password. Placeholder only: never write a real one here.
# SPRING_DATASOURCE_PASSWORD=change-me

# --- "Forgot password?" (Business Rule 33) -----------------------------------

# Optional. A support phone number the Sign in page shows after a "Forgot password?" request
# ("Or call BloodLink on ..."), shown as entered. Leave empty to show nothing.
BLOODLINK_SUPPORT_PHONE=

# Optional. The request form's answer never comes sooner than this many milliseconds, so a
# registered number cannot be told apart by speed. Default 500.
BLOODLINK_PASSWORD_RESET_MIN_RESPONSE_MS=500

# --- Rate limits (Business Rule 34) ------------------------------------------

# Optional. Sign-in, per phone number: this many FAILED attempts within the window lock
# that number for the lock time, even with the right password.
BLOODLINK_RATE_LIMIT_PHONE_MAX_FAILURES=3
BLOODLINK_RATE_LIMIT_PHONE_WINDOW_MINUTES=15
BLOODLINK_RATE_LIMIT_PHONE_LOCK_MINUTES=15

# Optional. Sign-in, per internet address: failed attempts by everyone sharing that address.
BLOODLINK_RATE_LIMIT_ADDRESS_MAX_FAILURES=30
BLOODLINK_RATE_LIMIT_ADDRESS_WINDOW_MINUTES=15
BLOODLINK_RATE_LIMIT_ADDRESS_WAIT_MINUTES=15

# Optional. "Forgot password?" requests per internet address, within the window.
BLOODLINK_RATE_LIMIT_PASSWORD_RESET_MAX_REQUESTS=10
BLOODLINK_RATE_LIMIT_PASSWORD_RESET_WINDOW_MINUTES=60

# Optional. New accounts per internet address, within the window. Only accounts created count.
BLOODLINK_RATE_LIMIT_REGISTRATION_MAX_ACCOUNTS=10
BLOODLINK_RATE_LIMIT_REGISTRATION_WINDOW_MINUTES=60

# Optional. The most numbers or addresses each limit remembers at once, so a flood cannot
# exhaust memory. Estimated worst case about 5 MB per limit at this default.
BLOODLINK_RATE_LIMIT_MAX_ENTRIES=10000

# Optional. false unless a proxy you control sits in front: a visitor can fake X-Forwarded-For.
# true reads the address from it, this many entries from the right (DEPLOYMENT.md, "Rate limits").
BLOODLINK_TRUST_PROXY_HEADERS=false
BLOODLINK_TRUSTED_PROXY_HOPS=1
