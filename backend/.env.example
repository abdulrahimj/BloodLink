# Every environment variable the backend reads, for running it WITHOUT Docker
# (`.\mvnw.cmd spring-boot:run` or `java -jar`). An uncommented line shows the
# default used when that variable is not set; a commented-out line (# NAME=...) is
# unset by default and shows an example or an obvious placeholder.
#
# Spring Boot does NOT read a .env file. Set these as environment variables in the
# terminal you start the backend from. The README shows how, in PowerShell:
#     $env:BLOODLINK_JWT_SECRET = "..."      (this terminal only)
# Never commit real values. If you copy this file to backend/.env, that copy is
# gitignored, but the backend still will not read it.
#
# Database credentials normally go in src/main/resources/application.properties
# (copied from application.properties.example, gitignored), not in variables.
#
# !! TESTS USE bloodlink_test ONLY. Never point tests at bloodlink_dev, which holds
# !! real data. The integration tests take their database from
# !! src/test/resources/application-test.properties, but a SPRING_DATASOURCE_*
# !! variable left set in your terminal would override it; IntegrationDatabaseGuard
# !! then refuses to run them. Set those variables per terminal, not permanently.

# --- Security ---------------------------------------------------------------

# REQUIRED for any real deployment: the login-token signing key, at least 32 bytes
# (48 random bytes in Base64 recommended; see README "Setting a real JWT secret").
# Optional on your own machine: when unset, the public placeholder is used, with a
# warning, under the default and "demo" profiles only. Empty or too short: refused.
# Changing it signs every user out.
# BLOODLINK_JWT_SECRET=paste-your-own-generated-value-here

# Optional. How long a login token lasts, in milliseconds. Default: 24 hours.
BLOODLINK_JWT_EXPIRATION_MS=86400000

# Optional. Comma-separated browser origins allowed to call the API and open the
# WebSocket. Default: Vite's local dev ports. Set to the frontend's real address
# when deploying.
BLOODLINK_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# --- Daily batch expiry notices (Business Rule 26) ---------------------------

# Optional. false turns off the daily job that tells blood bank staff about batches
# 7 days from expiry and expired batches still holding units. Default: on.
BLOODLINK_EXPIRY_NOTIFICATIONS_ENABLED=true

# Optional. When the job runs: a Spring cron (second minute hour day month weekday),
# read in UTC. Default: 06:00 every day.
BLOODLINK_EXPIRY_NOTIFICATIONS_CRON=0 0 6 * * *

# --- Server -----------------------------------------------------------------

# Optional. The port the backend listens on. Default: 8080.
SERVER_PORT=8080

# Optional. Unset means the default profile (your local bloodlink_dev). "demo" loads
# the fictional demo data into bloodlink_demo, never bloodlink_dev. Any other
# profile requires a real BLOODLINK_JWT_SECRET.
# SPRING_PROFILES_ACTIVE=demo

# --- Database (optional overrides) -------------------------------------------
# Standard Spring Boot variables. When set, they replace the datasource values in
# application.properties (or application-demo.properties). Unset, those files decide:
# the default profile uses bloodlink_dev as configured in your application.properties;
# the demo profile uses jdbc:postgresql://localhost:5432/bloodlink_demo as postgres.

# Optional. The JDBC address of the database.
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/bloodlink_dev

# Optional. Your PostgreSQL user name.
# SPRING_DATASOURCE_USERNAME=postgres

# Optional. Your PostgreSQL password. Placeholder only: never write a real one here.
# SPRING_DATASOURCE_PASSWORD=change-me
